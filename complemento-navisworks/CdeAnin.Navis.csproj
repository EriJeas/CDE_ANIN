<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Complemento de Navisworks "Publicar al CDE" (CDE ANIN). Mismo cliente y mismo formato que el complemento de Revit
    (ClienteCde.cs y Modelos.cs se comparten desde ..\complemento-revit\src). Requiere Navisworks Manage o Simulate
    instalado (Freedom no carga complementos). La API de Navisworks solo es compatible dentro de una version: se compila
    una DLL por version.
      Navisworks 2026:  dotnet build -c Release -p:NavisVersion=2026
      Otra carpeta:     dotnet build -c Release -p:NavisVersion=2026 -p:NavisDir="H:\Autodesk\Navisworks Manage 2026"
    Al compilar en Windows se instala en %AppData%\Autodesk\ApplicationPlugins\CdeAnin.Navis.bundle\ (abre Navisworks despues).
  -->
  <PropertyGroup>
    <NavisVersion Condition="'$(NavisVersion)' == ''">2026</NavisVersion>
    <NavisDir Condition="'$(NavisDir)' == '' And Exists('C:\Program Files\Autodesk\Navisworks Manage $(NavisVersion)')">C:\Program Files\Autodesk\Navisworks Manage $(NavisVersion)</NavisDir>
    <NavisDir Condition="'$(NavisDir)' == ''">C:\Program Files\Autodesk\Navisworks Simulate $(NavisVersion)</NavisDir>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CdeAnin.Navis</AssemblyName>
    <RootNamespace>CdeAnin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <Compile Include="..\complemento-revit\src\ClienteCde.cs" Link="compartido\ClienteCde.cs" />
    <Compile Include="..\complemento-revit\src\Modelos.cs" Link="compartido\Modelos.cs" />
    <Reference Include="Autodesk.Navisworks.Api"><HintPath>$(NavisDir)\Autodesk.Navisworks.Api.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Autodesk.Navisworks.ComApi"><HintPath>$(NavisDir)\Autodesk.Navisworks.ComApi.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Autodesk.Navisworks.Interop.ComApi"><HintPath>$(NavisDir)\Autodesk.Navisworks.Interop.ComApi.dll</HintPath><Private>false</Private><EmbedInteropTypes>false</EmbedInteropTypes></Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <Target Name="InstalaEnNavisworks" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup><Paquete>$(AppData)\Autodesk\ApplicationPlugins\CdeAnin.Navis.bundle</Paquete></PropertyGroup>
    <Copy SourceFiles="$(OutDir)CdeAnin.Navis.dll" DestinationFolder="$(Paquete)\Contents\$(NavisVersion)" />
    <Copy SourceFiles="PackageContents.xml" DestinationFolder="$(Paquete)" />
    <Message Importance="high" Text="Instalado en $(Paquete)\Contents\$(NavisVersion) (Navisworks $(NavisVersion), API de $(NavisDir))." />
  </Target>
</Project>
