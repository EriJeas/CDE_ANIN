<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Complemento de Revit "Publicar al CDE" (CDE ANIN). Deriva del complemento VisorBimCambios del Visor BIM (misma
    forma de compilar, de hablar con el servidor por llave y de probar fuera de Revit).
      Revit 2024:  dotnet build -c Release -p:RevitVersion=2024      (.NET Framework 4.8)
      Revit 2023:  dotnet build -c Release -p:RevitVersion=2023
      Revit 2025+: dotnet build -c Release -p:RevitVersion=2025      (.NET 8)
      Revit 2026.5+ (.NET 10): dotnet build -c Release -p:RevitVersion=2026 -p:RevitTfm=net10.0-windows
    Al compilar en Windows se copia a %AppData%\Autodesk\Revit\Addins\<version>\ (abre Revit despues).
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <RevitDir>C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitDir>
    <TargetFramework>net48</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &gt;= 2025">net8.0-windows</TargetFramework>
    <!-- Revit 2026.5 y posteriores usan .NET 10: -p:RevitTfm=net10.0-windows (3-compila-revit.bat lo hace solo si hace falta) -->
    <TargetFramework Condition="'$(RevitTfm)' != ''">$(RevitTfm)</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CdeAnin</AssemblyName>
    <RootNamespace>CdeAnin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2024">$(DefineConstants);REVIT_2024</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2022">$(DefineConstants);REVIT_2022</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <Reference Include="RevitAPI"><HintPath>$(RevitDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <Target Name="InstalaEnRevit" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup><Destino>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</Destino></PropertyGroup>
    <Copy SourceFiles="$(OutDir)CdeAnin.dll" DestinationFolder="$(Destino)\CdeAnin" />
    <!-- El manifiesto se escribe con la ruta ABSOLUTA de la DLL: con ruta relativa Revit no la encuentra
         cuando se lanza desde el acceso directo del Viewer o desde un archivo .rvt (directorio de trabajo distinto). -->
    <ReadLinesFromFile File="CdeAnin.addin"><Output TaskParameter="Lines" ItemName="LineasAddin" /></ReadLinesFromFile>
    <WriteLinesToFile File="$(Destino)\CdeAnin.addin" Lines="@(LineasAddin->Replace('&lt;Assembly&gt;CdeAnin\CdeAnin.dll&lt;/Assembly&gt;','&lt;Assembly&gt;$(Destino)\CdeAnin\CdeAnin.dll&lt;/Assembly&gt;'))" Overwrite="true" />
  </Target>
</Project>
